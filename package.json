{
  "name": "eclipse-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @eclipse/site dev",
    "build": "pnpm --filter @eclipse/site build",
    "test": "vitest run",
    "bake": "pnpm --filter @eclipse/bake exec tsx src/cli.ts",
    "parity": "playwright test --config tests/parity/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.180.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
