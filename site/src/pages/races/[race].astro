---
// A race's old page (and a search result for a race) opens that race in the wardrobe.
import { catalog } from "../../data/catalog";
import { u } from "../../lib/base";
import type { RaceEntry } from "@eclipse/format";

export function getStaticPaths() {
  return catalog.races.map((race) => ({ params: { race: race.id }, props: { race } }));
}
const race = Astro.props.race as RaceEntry;
const body = race.bodies.find((b) => b.model);
return Astro.redirect(u(body ? `wardrobe/?body=${body.id}&tab=customization` : "wardrobe/?tab=customization"));
---
