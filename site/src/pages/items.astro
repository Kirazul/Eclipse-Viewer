---
/** Items live in the wardrobe now. A plain redirect, written here so it keeps the base path. */
import { u } from "../lib/base";
const to = u("wardrobe/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Wardrobe | Eclipse</title>
  </head>
  <body><a href={to}>Open the wardrobe</a></body>
</html>
