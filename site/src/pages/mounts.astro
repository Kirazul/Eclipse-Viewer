---
import Shell from "../layouts/Shell.astro";
import GroupedList from "../components/GroupedList.astro";
import Notice from "../components/Notice.astro";
import { catalog } from "../data/catalog";
import { wardrobeHref } from "../lib/base";
---
<Shell title="Mounts" subtitle="Every mount, in 3D." nav="mounts">
  {catalog.mounts.length === 0 ? (
    <Notice title="Mounts are on their way" body="They show up here as soon as they are baked." />
  ) : (
    <GroupedList entries={catalog.mounts} link={(e) => (e.model ? wardrobeHref(e.id) : null)} />
  )}
</Shell>
